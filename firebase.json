{
  "functions": [
    {
      "source": "functions",
      "codebase": "store-monitor",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": "store-assets",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
